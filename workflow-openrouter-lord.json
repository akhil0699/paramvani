              "value": "Conversational"
            },
            {
              "name": "multiNativeLocale",
              "value": "hi-IN"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 0],
      "id": "murf-tts",
      "name": "Murf TTS"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "audioFile",
              "value": "={{ $json.audioFile || $json.audio_file || $json.url }}",
              "type": "string"
            },
            {
              "name": "response",
              "value": "={{ $('Parse AI Response').item.json.cleaned_output }}",
              "type": "string"
            },
            {
              "name": "transcript",
              "value": "={{ $('Parse AI Response').item.json.cleaned_output }}",
              "type": "string"
            },
            {
              "name": "lordId",
              "value": "={{ $('Parse AI Response').item.json.lordId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1880, 0],
      "id": "format-response",
      "name": "Format Webhook Response"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [2080, 0],
      "id": "respond-webhook",
      "name": "Respond to Webhook"
    }
  ],
